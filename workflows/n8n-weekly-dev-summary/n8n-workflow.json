      "id": "claude-api",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "jsCode": "// Build prompt for Claude from activity data\nconst data = $input.first().json;\nconst lang = $vars.LANGUAGE || 'EN';\n\nconst isFrench = lang === 'FR';\n\nconst prompt = isFrench\n  ? `Génère un résumé narratif des activités de développement pour le dépôt ${data.repo} sur la période du ${data.period.from} au ${data.period.to}.\n\n**Statistiques:**\n- ${data.stats.totalCommits} commits\n- ${data.stats.totalClosedIssues} issues fermées\n- ${data.stats.totalMergedPRs} PRs fusionnées\n\n**Commits récents:**\n${data.commits.map(c => `- ${c.sha}: ${c.message} (${c.author})`).join('\\n')}\n\n**Issues fermées:**\n${data.closedIssues.map(i => `- #${i.number}: ${i.title}`).join('\\n')}\n\n**PRs fusionnées:**\n${data.mergedPRs.map(pr => `- #${pr.number}: ${pr.title} (par @${pr.author})`).join('\\n')}\n\nFournis un résumé narratif clair et informatif qui met en évidence les accomplissements majeurs et les tendances.`\n  : `Generate a narrative summary of development activities for the ${data.repo} repository for the period from ${data.period.from} to ${data.period.to}.\n\n**Stats:**\n- ${data.stats.totalCommits} commits\n- ${data.stats.totalClosedIssues} closed issues\n- ${data.stats.totalMergedPRs} merged PRs\n\n**Recent Commits:**\n${data.commits.map(c => `- ${c.sha}: ${c.message} (${c.author})`).join('\\n')}\n\n**Closed Issues:**\n${data.closedIssues.map(i => `- #${i.number}: ${i.title}`).join('\\n')}\n\n**Merged PRs:**\n${data.mergedPRs.map(pr => `- #${pr.number}: ${pr.title} (by @${pr.author})`).join('\\n')}\n\nProvide a clear, informative narrative summary highlighting major accomplishments and trends.`;\n\nreturn { prompt };;"
      },
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -200]
    },
    {
      "parameters": {
        "jsCode": "// Extract the summary from Claude's response\nconst response = $input.first().json;\nconst content = response.content?.[0]?.text || response.error?.message || 'No summary generated';\nconst dateInfo = $('Calculate Date Range').first().json;\n\nconst notification = {\n  summary: content,\n  period: `${dateInfo.sinceFormatted} - ${dateInfo.untilFormatted}`,\n  repo: $vars.GITHUB_REPO || 'owner/repo'\n};\n\nreturn notification;"
      },
