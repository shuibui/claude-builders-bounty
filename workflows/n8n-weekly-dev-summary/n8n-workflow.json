      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 200]
    },
    {
      "parameters": {
        "jsCode": "// Calculate date range for the past week\nconst now = new Date();\nconst since = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst until = now;\n\n// Format dates to ISO string for GitHub API\nconst sinceStr = since.toISOString();\nconst untilStr = until.toISOString();\n\nreturn {\n  since: sinceStr,\n  until: untilStr,\n  sinceFormatted: since.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),\n  untilFormatted: until.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n};"
      },
      "id": "date-calculator",
      "name": "Calculate Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Filter merged PRs from closed PRs\nconst prs = $input.all();\nconst mergedPRs = prs.filter(pr => pr.json.merged_at !== null);\n\n// Filter PRs merged in the last week\nconst since = new Date($vars.SINCE || new Date(Date.now() - 7 * 24 * 60 * 60 * 1000));\nconst recentMerged = mergedPRs.filter(pr => {\n  const mergedAt = new Date(pr.json.merged_at);\n  return mergedAt >= since;\n});\n\nreturn recentMerged;"
      },
      "id": "filter-merged-prs",
      "name": "Filter Merged PRs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "jsCode": "// Compile activity data for Claude\nconst commits = $('Fetch Commits').all();\nconst closedIssues = $('Fetch Closed Issues').all();\nconst mergedPRs = $('Filter Merged PRs').all();\nconst dateInfo = $('Calculate Date Range').first().json;\n\n// Build a concise summary of activity\nconst summary = {\n  repo: $vars.GITHUB_REPO || 'owner/repo',\n  period: {\n    from: dateInfo.sinceFormatted,\n    to: dateInfo.untilFormatted\n  },\n  commits: commits.slice(0, 50).map(c => ({\n    sha: c.json.sha?.substring(0, 7),\n    message: c.json.commit?.message?.split('\\n')[0]?.substring(0, 100),\n    author: c.json.commit?.author?.name,\n    date: c.json.commit?.author?.date\n  })),\n  closedIssues: closedIssues.slice(0, 30).map(i => ({\n    number: i.json.number,\n    title: i.json.title?.substring(0, 100),\n    closedAt: i.json.closed_at\n  })),\n  mergedPRs: mergedPRs.slice(0, 30).map(pr => ({\n    number: pr.json.number,\n    title: pr.json.title?.substring(0, 100),\n    mergedAt: pr.json.merged_at,\n    author: pr.json.user?.login\n  })),\n  stats: {\n    totalCommits: commits.length,\n    totalClosedIssues: closedIssues.length,\n    totalMergedPRs: mergedPRs.length\n  }\n};\n\nreturn summary;"
      },
      "id": "compile-data",
      "name": "Compile Activity Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$vars.CLAUDE_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-20250514"
            },
            {
              "name": "max_tokens",
              "value": 2048
            },
            {
              "name": "system",
              "value": "={{$vars.LANGUAGE === 'FR' ? 'Tu es un assistant qui génère des résumés narratifs en français des activités de développement logiciel. Sois concis mais informatif.' : 'You are an assistant that generates narrative summaries in English of software development activities. Be concise but informative.'}}"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"={{ $json.prompt }}\"}]"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
