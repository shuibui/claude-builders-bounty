#!/bin/bash
# Claude Code Pre-Tool-Use Hook: Block Destructive Commands
# Location: ~/.claude/hooks/pre-tool-use/destructive-hook.sh
# 
# This hook intercepts dangerous bash commands before execution.
# Place this script at: ~/.claude/hooks/pre-tool-use/destructive-hook

set -euo pipefail

# Log file for blocked attempts
LOG_FILE="${HOME}/.claude/hooks/blocked.log"

# Get the command from the first argument
COMMAND="$1"

# Patterns to block
BLOCKED_PATTERNS=(
    "rm -rf /"
    "rm -rf /home"
    "rm -rf /tmp"
    "rm -rf /var"
    "rm -rf /etc"
    "DROP TABLE"
    "TRUNCATE"
    "DELETE FROM [^W]"
    "git push --force"
    "git push -f"
    "format.*:.*;"
    "DROP DATABASE"
    "sudo rm"
    "> /dev/sda"
    "mkfs"
    ":(){ :|:& };:"
)

# Check if command matches any blocked pattern
is_blocked() {
    local cmd="$1"
    for pattern in "${BLOCKED_PATTERNS[@]}"; do
        if echo "$cmd" | grep -iqE "$pattern"; then
            return 0
        fi
    done
    return 1
}

# Log blocked attempt
log_blocked() {
    local cmd="$1"
    local project="${PWD:-unknown}"
    local timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "[$timestamp] BLOCKED: $cmd | Project: $project" >> "$LOG_FILE"
}

# Main
if is_blocked "$COMMAND"; then
    log_blocked "$COMMAND"
    echo "🔒 HOOK: BLOCKED dangerous command"
    echo ""
    echo "The command you tried to run was blocked by the pre-tool-use hook:"
    echo ""
    echo "  $COMMAND"
    echo ""
    echo "Reason: This command could cause irreversible damage to your system or data."
    echo ""
    echo "If you're certain this command is safe, you can:"
    echo "  1. Run it outside of Claude Code"
    echo "  2. Temporarily disable the hook by moving this file"
    echo ""
    echo "This blocked attempt has been logged to: $LOG_FILE"
    exit 1
fi

# Allow the command to proceed
exit 0
